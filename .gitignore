# 运行时数据（用户上传的文件，不纳入版本控制）
/data/*
!/data/.gitkeep

# 本地编译产物
/philoftp
/philoftp.exe

# 构建产物：dist 下所有二进制/压缩包由 `make dist` 重新生成，不纳入版本控制
/dist/
# 若希望保留空目录结构，可在此添加对应的 !dist/xxx/.gitkeep 例外

# Go 构建缓存
*.test
*.out

# 编辑器/系统文件
.DS_Store
*.swp

# 运行时用户数据库（首次启动生成，含 bcrypt 哈希，不入库）
/configs/users.db
# 旧 users.json 迁移后的重命名产物
*.json.migrated

# 工作记忆（IDE/agent 内部目录，不纳入代码仓库）
/.codebuddy/
